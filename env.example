# 复制为 .env 后按需修改；所有值都可留空使用默认。
# 修改 ADMIN_PASSWORD 只影响首次初始化，已有管理员不会被覆盖。

# 访问端口（宿主机）
APP_PORT=8000

# 会话签名密钥。留空会在 data/.app_secret 自动生成并持久化；
# 生产环境建议填一段 32 位以上的随机字符串。
APP_SECRET=

# 首次启动创建的管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 会话有效期（天）
SESSION_DAYS=7

# 通过 HTTPS 反代访问时设为 true，Cookie 会加 Secure
COOKIE_SECURE=false

# 可选：首次初始化时写入 DeepSeek 密钥（之后也可在后台设置）
DEEPSEEK_API_KEY=

# 是否在全新数据库中写入 24 条演示商品（默认 false；真实数据请用导入功能）
SEED_DEMO=false

# 容器内访问宿主机 Ollama 的地址
OLLAMA_BASE_URL=http://host.docker.internal:11434

# 时区
TZ=Asia/Shanghai

# 构建时 pip 镜像（国内可改为 https://pypi.tuna.tsinghua.edu.cn/simple）
PIP_INDEX_URL=https://pypi.org/simple
